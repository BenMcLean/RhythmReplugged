{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Visual Studio 17 2022",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"VCPKG_MANIFEST_MODE": "ON"
			}
		},
		{
			"name": "windows-x86",
			"displayName": "Windows x86",
			"description": "Legacy 32-bit Windows build with shared vcpkg dependencies.",
			"inherits": "base",
			"architecture": {
				"value": "Win32",
				"strategy": "set"
			},
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x86-windows"
			}
		},
		{
			"name": "windows-x64",
			"displayName": "Windows x64",
			"description": "Recommended 64-bit Windows build with static vcpkg dependencies.",
			"inherits": "base",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-windows-static"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-x64-debug",
			"displayName": "Windows x64 Debug",
			"configurePreset": "windows-x64",
			"configuration": "Debug"
		},
		{
			"name": "windows-x64-release",
			"displayName": "Windows x64 Release",
			"configurePreset": "windows-x64",
			"configuration": "Release"
		},
		{
			"name": "windows-x86-debug",
			"displayName": "Windows x86 Debug",
			"configurePreset": "windows-x86",
			"configuration": "Debug"
		},
		{
			"name": "windows-x86-release",
			"displayName": "Windows x86 Release",
			"configurePreset": "windows-x86",
			"configuration": "Release"
		}
	]
}
