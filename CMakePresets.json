{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
				"VCPKG_MANIFEST_MODE": "ON"
			}
		},
		{
			"name": "windows-base",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-x64",
			"displayName": "Windows x64",
			"description": "Recommended 64-bit Windows build with static vcpkg dependencies.",
			"inherits": "windows-base",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-windows-static"
			}
		},
		{
			"name": "windows-mingw-base",
			"hidden": true,
			"inherits": "base",
			"generator": "Ninja",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"environment": {
				"PATH": "C:/tools/msys64/ucrt64/bin;$penv{PATH}"
			},
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "x64-mingw-static",
				"VCPKG_HOST_TRIPLET": "x64-mingw-static",
				"CMAKE_C_COMPILER": "C:/tools/msys64/ucrt64/bin/gcc.exe",
				"CMAKE_CXX_COMPILER": "C:/tools/msys64/ucrt64/bin/g++.exe",
				"CMAKE_MAKE_PROGRAM": "C:/tools/msys64/ucrt64/bin/ninja.exe"
			}
		},
		{
			"name": "windows-mingw-debug",
			"displayName": "Windows MinGW Debug",
			"description": "FOSS GCC toolchain from MSYS2 UCRT64.",
			"inherits": "windows-mingw-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "windows-mingw-release",
			"displayName": "Windows MinGW Release",
			"description": "FOSS GCC toolchain from MSYS2 UCRT64.",
			"inherits": "windows-mingw-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "linux-debug",
			"displayName": "Linux Debug",
			"description": "Linux desktop build with shared vcpkg dependencies.",
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"VCPKG_TARGET_TRIPLET": "x64-linux"
			}
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release",
			"description": "Linux desktop build with shared vcpkg dependencies.",
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_TARGET_TRIPLET": "x64-linux"
			}
		},
		{
			"name": "linux-arm64-cross-base",
			"displayName": "Linux ARM64 Cross Base",
			"description": "Shared WSL/Linux cross-compilation settings for ARM64/AArch64 output.",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"generator": "Ninja",
			"cacheVariables": {
				"VCPKG_TARGET_TRIPLET": "arm64-linux",
				"VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/linux-aarch64-gcc.cmake"
			}
		},
		{
			"name": "linux-arm64-debug",
			"displayName": "Linux ARM64 Debug",
			"description": "Cross-compiled ARM64 Linux SDL3 desktop build for use from WSL or another x64 Linux host.",
			"inherits": "linux-arm64-cross-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"RR_BUILD_SDL3_FRONTEND": "ON",
				"RR_BUILD_LIBRETRO_CORE": "OFF",
				"RR_RENDER_USE_GLES": "ON"
			}
		},
		{
			"name": "linux-arm64-release",
			"displayName": "Linux ARM64 Release",
			"description": "Cross-compiled ARM64 Linux SDL3 desktop build for use from WSL or another x64 Linux host.",
			"inherits": "linux-arm64-cross-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"RR_BUILD_SDL3_FRONTEND": "ON",
				"RR_BUILD_LIBRETRO_CORE": "OFF",
				"RR_RENDER_USE_GLES": "ON"
			}
		},
		{
			"name": "linux-libretro-debug-internal",
			"displayName": "Linux Libretro Debug (Internal)",
			"description": "Internal libretro-only build without SDL3 frontend dependencies.",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"VCPKG_TARGET_TRIPLET": "x64-linux",
				"VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
				"RR_BUILD_SDL3_FRONTEND": "OFF",
				"RR_BUILD_LIBRETRO_CORE": "ON"
			}
		},
		{
			"name": "linux-libretro-release-internal",
			"displayName": "Linux Libretro Release (Internal)",
			"description": "Internal libretro-only build without SDL3 frontend dependencies.",
			"hidden": true,
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_TARGET_TRIPLET": "x64-linux",
				"VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
				"RR_BUILD_SDL3_FRONTEND": "OFF",
				"RR_BUILD_LIBRETRO_CORE": "ON"
			}
		},
		{
			"name": "linux-arm64-libretro-debug",
			"displayName": "Linux ARM64 Libretro Debug",
			"description": "Cross-compiled ARM64 libretro core build for Raspberry Pi 4/5 class systems using OpenGL ES 3.",
			"inherits": "linux-arm64-cross-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
				"RR_BUILD_SDL3_FRONTEND": "OFF",
				"RR_BUILD_LIBRETRO_CORE": "ON",
				"RR_RENDER_USE_GLES": "ON"
			}
		},
		{
			"name": "linux-arm64-libretro-release",
			"displayName": "Linux ARM64 Libretro Release",
			"description": "Cross-compiled ARM64 libretro core build for Raspberry Pi 4/5 class systems using OpenGL ES 3.",
			"inherits": "linux-arm64-cross-base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"VCPKG_MANIFEST_NO_DEFAULT_FEATURES": "ON",
				"RR_BUILD_SDL3_FRONTEND": "OFF",
				"RR_BUILD_LIBRETRO_CORE": "ON",
				"RR_RENDER_USE_GLES": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-x64-debug",
			"displayName": "Windows x64 Debug",
			"configurePreset": "windows-x64",
			"configuration": "Debug",
			"targets": [
				"windows_artifacts"
			]
		},
		{
			"name": "windows-x64-release",
			"displayName": "Windows x64 Release",
			"configurePreset": "windows-x64",
			"configuration": "Release",
			"targets": [
				"windows_artifacts"
			]
		},
		{
			"name": "windows-mingw-debug",
			"configurePreset": "windows-mingw-debug"
		},
		{
			"name": "windows-mingw-release",
			"configurePreset": "windows-mingw-release"
		},
		{
			"name": "linux-debug",
			"displayName": "Linux Debug",
			"configurePreset": "linux-debug"
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release",
			"configurePreset": "linux-release"
		},
		{
			"name": "linux-arm64-debug",
			"displayName": "Linux ARM64 Debug",
			"configurePreset": "linux-arm64-debug",
			"targets": [
				"stage_sdl3"
			]
		},
		{
			"name": "linux-arm64-release",
			"displayName": "Linux ARM64 Release",
			"configurePreset": "linux-arm64-release",
			"targets": [
				"stage_sdl3"
			]
		},
		{
			"name": "linux-libretro-debug-internal",
			"displayName": "Linux Libretro Debug (Internal)",
			"hidden": true,
			"configurePreset": "linux-libretro-debug-internal"
		},
		{
			"name": "linux-libretro-release-internal",
			"displayName": "Linux Libretro Release (Internal)",
			"hidden": true,
			"configurePreset": "linux-libretro-release-internal"
		},
		{
			"name": "linux-arm64-libretro-debug",
			"displayName": "Linux ARM64 Libretro Debug",
			"configurePreset": "linux-arm64-libretro-debug",
			"targets": [
				"stage_libretro"
			]
		},
		{
			"name": "linux-arm64-libretro-release",
			"displayName": "Linux ARM64 Libretro Release",
			"configurePreset": "linux-arm64-libretro-release",
			"targets": [
				"stage_libretro"
			]
		}
	]
}
