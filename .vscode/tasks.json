{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Windows Artifacts (Debug)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"windows-x64-debug"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		},
		{
			"label": "Build Windows Artifacts (Release)",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"windows-x64-release"
			],
			"group": "build",
			"problemMatcher": "$msCompile",
			"options": {
				"cwd": "${workspaceFolder}"
			}
		}
	]
}
